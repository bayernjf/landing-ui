---
import Icon from './Icon.astro';

interface Props {
  /** Repository to star, e.g. https://github.com/bayernjf/splity */
  href: string;
  /** Appearance classes from the host site — display, color, visibility. */
  class?: string;
  /** Icon size in px. 15 in nav, 14 in footer matches the label's cap height. */
  size?: number | string;
  /** Visible label. */
  label?: string;
}

const { href, class: className = '', size = 15, label = 'Star on GitHub', ...rest } = Astro.props;

// The pill's box lives on the inner span, not the anchor, for the same reason
// BayjfLink sets no `display`: scoped component CSS outranks a single-class
// utility, so a `display` here would defeat `hidden sm:inline-flex` on the host
// side. Leaving the anchor's display and color alone keeps those utilities in
// charge, and the span still tints itself from the inherited currentColor.
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class:list={['lui-star', className]}
  {...rest}
>
  <span class="lui-star-pill">
    <Icon name="Github" size={size} />
    <span>{label}</span>
  </span>
</a>

<style>
  .lui-star {
    text-decoration: none;
  }

  .lui-star-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    transition:
      background-color 200ms ease-out,
      border-color 200ms ease-out,
      transform 200ms ease-out;
  }

  .lui-star:hover .lui-star-pill {
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-color: color-mix(in srgb, currentColor 24%, transparent);
    transform: scale(1.05);
  }

  .lui-star:active .lui-star-pill {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .lui-star-pill {
      transition: none;
    }

    .lui-star:hover .lui-star-pill,
    .lui-star:active .lui-star-pill {
      transform: none;
    }
  }
</style>
